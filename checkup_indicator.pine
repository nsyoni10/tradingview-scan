//@version=5
// Checkup — כמה אינדיקטורים מובנים של טריידינגוויו באינדיקטור אחד, ועליהם הסטטוס של הסקיל checkup.
// חלון תחתון: DMI (ADX, +DI, -DI) כמו האינדיקטור המובנה Directional Movement Index.
// גרף המחיר (force_overlay): EMA20, EMA50, SMA150, בולינגר יומי, בולינגר שבועי, מרובוזו וטבלת הסטטוס.
// צבע, עובי והסתרה של כל קו — בלשונית Style.
indicator("Checkup", overlay = false, max_labels_count = 500)

// ── הגדרות ───────────────────────────────────────────────────────────
minAvgVol = input.int(500000, "ווליום ממוצע מינימלי (10 ימים)", group = "סטטוס")
bbLen     = input.int(20,     "בולינגר: אורך", group = "בולינגר")
bbMult    = input.float(2.0,  "בולינגר: סטיות תקן", group = "בולינגר")
weeklyTf  = input.timeframe("W", "בולינגר: טווח זמן גבוה", group = "בולינגר")
diLen     = input.int(14,     "DI Length", group = "DMI")
adxLen    = input.int(14,     "ADX Smoothing", group = "DMI")

// ── Moving Average Exponential / Simple (כמו המובנים) ────────────────
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
sma150 = ta.sma(close, 150)

// ── Bollinger Bands (כמו המובנה: SMA ± mult × stdev) ─────────────────
bbMid = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUp  = bbMid + bbDev
bbLow = bbMid - bbDev
[wMid, wUp, wLow] = request.security(syminfo.tickerid, weeklyTf, [ta.sma(close, bbLen), ta.sma(close, bbLen) + bbMult * ta.stdev(close, bbLen), ta.sma(close, bbLen) - bbMult * ta.stdev(close, bbLen)])

// ── Directional Movement Index (הקוד של האינדיקטור המובנה) ────────────
upMove   = ta.change(high)
downMove = -ta.change(low)
plusDM   = na(upMove) ? na : (upMove > downMove and upMove > 0 ? upMove : 0)
minusDM  = na(downMove) ? na : (downMove > upMove and downMove > 0 ? downMove : 0)
trur     = ta.rma(ta.tr, diLen)
diPlus   = fixnan(100 * ta.rma(plusDM, diLen) / trur)
diMinus  = fixnan(100 * ta.rma(minusDM, diLen) / trur)
diSum    = diPlus + diMinus
adx      = 100 * ta.rma(math.abs(diPlus - diMinus) / (diSum == 0 ? 1 : diSum), adxLen)

// ── ATR, CCI, ווליום ─────────────────────────────────────────────────
atr   = ta.atr(14)
cci   = ta.cci(hlc3, 20)
vol10 = ta.sma(volume, 10)
rvol  = volume / ta.sma(volume, 10)[1]       // היום מול 10 הימים שלפניו

// מיקום ברצועה ביחידות σ: 0 = על הממוצע, +2 = על הרצועה העליונה
bbPos(c, mid, up) => up > mid ? (c - mid) / ((up - mid) / bbMult) : na
bd = bbPos(close, bbMid, bbUp)
bw = bbPos(close, wMid, wUp)

// ── מרובוזו ירוק ב-3 הימים האחרונים ──────────────────────────────────
isMaru(i) =>
    rng = high[i] - low[i]
    body = close[i] - open[i]
    rng > 0 and body > 0 and body / rng >= 0.85 and body >= 0.5 * atr
maruAgo = isMaru(0) ? 0 : isMaru(1) ? 1 : isMaru(2) ? 2 : -1

// ── נר אחרון (כמו ticker_report.candle) ───────────────────────────────
up    = diPlus > diMinus
trendUp = close > ema20 and ema20 > ema50 and up
rng   = math.max(high - low, 1e-9)
body  = math.abs(close - open)
upperW = high - math.max(open, close)
lowerW = math.min(open, close) - low
green = close > open
red   = close < open
prevGreen = close[1] > open[1]
prevRed   = close[1] < open[1]

var string tags = ""
tags := ""
cpts = 10.0
hammerTag = false
if lowerW >= 2 * body and upperW <= 0.3 * rng and body > 0
    if trendUp
        tags := "איש תלוי"
        cpts -= 8
    else
        tags := "פטיש"
        hammerTag := true
        cpts += 10
else if upperW >= 2 * body and lowerW <= 0.3 * rng and body > 0
    if trendUp
        tags := "כוכב נופל"
        cpts -= 8
    else
        tags := "פטיש הפוך"
        hammerTag := true
        cpts += 4
strong = body / rng >= 2.0 / 3.0
if strong and green and prevRed
    tags := tags + (tags == "" ? "" : ", ") + "נר 2/3 ירוק אחרי אדום"
    cpts += trendUp ? 15 : 8
else if strong
    tags := tags + (tags == "" ? "" : ", ") + (green ? "גוף מלא ירוק" : "גוף מלא אדום")
    cpts += green ? 3 : -5
if green and prevRed and open <= close[1] and close >= open[1]
    tags := tags + (tags == "" ? "" : ", ") + "בולעני עולה"
    cpts += 10
if red and prevGreen and open >= close[1] and close <= open[1]
    tags := tags + (tags == "" ? "" : ", ") + "בולעני יורד"
    cpts -= 10
if body / rng < 0.1
    tags := tags + (tags == "" ? "" : ", ") + "דוג'י"
else if red and not hammerTag
    tags := tags == "" ? "נר אדום" : tags
    cpts -= 5
else if green
    cpts += 3
cpts := math.max(math.min(cpts, 25), 0)

// ── ציון כניסה 0-100 (כמו checkup.score) ─────────────────────────────
sDir  = up ? 15 + (adx >= 20 ? 10 : adx >= 18 ? 5 : 0) + (adx > adx[1] ? 5 : 0) : 0
sCnd  = (maruAgo == 0 ? 15 : maruAgo > 0 ? 10 : 0) + cpts * 0.4
sVol  = green ? (rvol >= 1.5 ? 15 : rvol >= 1.2 ? 10 : rvol >= 1.0 ? 4 : 0) : 0
cciUp = cci > cci[1]
sCci  = cciUp and ((cci[1] < -100 and cci >= -100) or (cci[1] < 0 and cci >= 0)) ? 15 : cciUp and cci < 100 ? 10 : cciUp and cci < 200 ? 4 : 0
sSma  = close > sma150 ? 10 : 0
sStr  = not na(bd) and bd <= bbMult ? 5 : 0
score = math.round(sDir + sCnd + sVol + sCci + sSma + sStr)

// ── סטטוס (כמו checkup.status) ───────────────────────────────────────
string status = ""
string why = ""
color stColor = color.gray
if vol10 < minAvgVol
    status := "⛔ לא לסחור"
    why := "ווליום נמוך: " + str.tostring(vol10, "#,###") + " ביום"
else if atr / close < 0.005
    status := "⛔ לא לסחור"
    why := "מחיר קפוא"
else if not up and adx >= 20
    status := "⛔ לא לסחור"
    why := "מגמת ירידה (-DI מעל +DI, ADX ≥ 20)"
else if not up or (adx < 20 and adx <= adx[1])
    status := "⛔ לא לסחור"
    why := "אין עדיין כיוון ללונג"
else if not na(bw) and bw > bbMult
    status := "🔴 מתוחה בשבועי"
    why := "מעל הרצועה העליונה השבועית"
    stColor := color.red
else if not na(bd) and bd > bbMult
    status := "👁 מעקב"
    why := "מתוחה ביומי, טובה בשבועי"
    stColor := color.orange
else if adx >= 20
    status := "✅ יש מקום"
    why := "טובה בשבועי וביומי, ADX ≥ 20"
    stColor := color.green
else
    status := "🔵 כמעט שם"
    why := "טובה בשבועי וביומי, ADX < 20 ועולה"
    stColor := color.blue

// ── חלון תחתון: DMI ──────────────────────────────────────────────────
plot(adx,     title = "ADX", color = #F50057, linewidth = 2)
plot(diPlus,  title = "+DI", color = #00C853, linewidth = 1)
plot(diMinus, title = "-DI", color = #FF1744, linewidth = 1)
hline(20, title = "סף ADX 20", color = #787B86, linestyle = hline.style_dashed)
plot(atr, title = "ATR", color = #787B86, display = display.status_line + display.data_window)
plot(cci, title = "CCI(20)", color = #787B86, display = display.status_line + display.data_window)

// ── גרף המחיר ────────────────────────────────────────────────────────
plot(ema20,  title = "EMA20",  color = #FF9800, linewidth = 1, force_overlay = true)
plot(ema50,  title = "EMA50",  color = #9C27B0, linewidth = 1, force_overlay = true)
plot(sma150, title = "SMA150", color = #000000, linewidth = 2, force_overlay = true)
plot(bbUp,   title = "בולינגר יומי עליון", color = #2962FF, linewidth = 1, force_overlay = true)
plot(bbMid,  title = "בולינגר יומי אמצע",  color = #2962FF, linewidth = 1, style = plot.style_circles, force_overlay = true)
plot(bbLow,  title = "בולינגר יומי תחתון", color = #2962FF, linewidth = 1, force_overlay = true)
plot(wUp,    title = "בולינגר שבועי עליון", color = #F44336, linewidth = 2, style = plot.style_stepline, force_overlay = true)
plot(wMid,   title = "בולינגר שבועי אמצע",  color = #F44336, linewidth = 1, style = plot.style_stepline, force_overlay = true)
plot(wLow,   title = "בולינגר שבועי תחתון", color = #F44336, linewidth = 2, style = plot.style_stepline, force_overlay = true)
plotshape(isMaru(0), title = "מרובוזו", style = shape.triangleup, location = location.belowbar, color = #4CAF50, size = size.tiny, force_overlay = true)

// ── טבלה על גרף המחיר: כל תנאי, הערך שלו ואם הוא מתקיים ───────────────
var table t = table.new(position.top_right, 3, 13, border_width = 1, force_overlay = true)
okBg  = color.new(color.green, 75)
badBg = color.new(color.red, 75)
nBg   = color.new(color.gray, 85)
row(i, k, v, ok) =>
    table.cell(t, 0, i, k, text_color = color.white, bgcolor = color.navy, text_size = size.small)
    table.cell(t, 1, i, v, text_color = color.black, bgcolor = nBg, text_size = size.small)
    table.cell(t, 2, i, ok ? "✅" : "❌", text_color = color.black, bgcolor = ok ? okBg : badBg, text_size = size.small)

if barstate.islast
    if timeframe.period != "D"
        table.cell(t, 0, 0, "Checkup", text_color = color.white, bgcolor = color.navy)
        table.cell(t, 1, 0, "להפעיל על גרף יומי (D)", bgcolor = color.yellow)
    else
        table.cell(t, 0, 0, "סטטוס", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 0, status, text_color = color.black, bgcolor = color.new(stColor, 60), text_size = size.small)
        table.cell(t, 2, 0, "ציון " + str.tostring(score), text_color = color.black, bgcolor = nBg, text_size = size.small)
        table.cell(t, 0, 1, "סיבה", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 1, why, text_color = color.black, bgcolor = nBg, text_size = size.small)
        table.cell(t, 2, 1, "", bgcolor = nBg)
        row(2,  "ווליום ממוצע ≥ " + str.tostring(minAvgVol, "#,###"), str.tostring(vol10, "#,###"), vol10 >= minAvgVol)
        row(3,  "+DI מעל -DI",          str.tostring(diPlus, "0.0") + " / " + str.tostring(diMinus, "0.0"), up)
        row(4,  "ADX ≥ 20",             str.tostring(adx, "0.0") + (adx > adx[1] ? " ↑" : " ↓"), adx >= 20)
        row(5,  "בולינגר שבועי ≤ +2σ",  (na(bw) ? "—" : str.tostring(bw, "+0.00;-0.00")) + "σ", na(bw) or bw <= bbMult)
        row(6,  "בולינגר יומי ≤ +2σ",   (na(bd) ? "—" : str.tostring(bd, "+0.00;-0.00")) + "σ", na(bd) or bd <= bbMult)
        row(7,  "מעל SMA150",           str.tostring(sma150, "0.00"), close > sma150)
        row(8,  "RVOL ≥ 1.2",           str.tostring(rvol, "0.00"), rvol >= 1.2)
        row(9,  "CCI עולה",             str.tostring(cci, "0") + " (אתמול " + str.tostring(cci[1], "0") + ")", cciUp)
        row(10, "מרובוזו ב-3 ימים",     maruAgo == 0 ? "היום" : maruAgo == 1 ? "אתמול" : maruAgo == 2 ? "לפני 2 ימים" : "—", maruAgo >= 0)
        row(11, "ATR",                  str.tostring(atr, "0.00") + " (" + str.tostring(atr / close * 100, "0.0") + "%)", atr / close >= 0.005)
        row(12, "נר אחרון",             tags == "" ? "—" : tags, cpts >= 10)
