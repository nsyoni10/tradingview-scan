//@version=6
indicator(title="Checkup", shorttitle="Checkup", overlay=true)
// מיכל של אינדיקטורים מובנים של TradingView. כל אחד מועתק מקוד המקור (גרסה 6) כמו שהוא.
// מה ששונה רק כדי שכולם ייכנסו לאינדיקטור אחד: שמות המשתנים (קידומת), קבוצה לכל אינדיקטור,
// ערך ברירת המחדל של Length, ובבולינגר השבועי — Timeframe כשדה (במקור הוא חלק מהגדרות האינדיקטור).

// ══ EMA 1 — Moving Average Exponential ═══════════════════════════════
e1G = "EMA 1"
e1len = input.int(20, minval=1, title="Length", group = e1G)
e1src = input(close, title="Source", group = e1G)
e1offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.none, group = e1G)
e1out = ta.ema(e1src, e1len)
plot(e1out, title="EMA 1", color=color.blue, offset=e1offset)

// Smoothing MA inputs
e1GRP = "EMA 1 Smoothing"
TT_BB = "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands."
e1maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = e1GRP, display = display.none)
var e1isBB = e1maTypeInput == "SMA + Bollinger Bands"
e1maLengthInput = input.int(14, "Length", group = e1GRP, display = display.none, active = e1maTypeInput != "None")
e1bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = e1GRP, display = display.none, active = e1isBB)
var e1enableMA = e1maTypeInput != "None"

// Smoothing MA Calculation
ma(source, length, MAtype) =>
	switch MAtype
		"SMA"                   => ta.sma(source, length)
		"SMA + Bollinger Bands" => ta.sma(source, length)
		"EMA"                   => ta.ema(source, length)
		"SMMA (RMA)"            => ta.rma(source, length)
		"WMA"                   => ta.wma(source, length)
		"VWMA"                  => ta.vwma(source, length)

// Smoothing MA plots
e1smoothingMA = e1enableMA ? ma(e1out, e1maLengthInput, e1maTypeInput) : na
e1smoothingStDev = e1isBB ? ta.stdev(e1out, e1maLengthInput) * e1bbMultInput : na
plot(e1smoothingMA, "EMA 1 Smoothing MA", color=color.yellow, display = e1enableMA ? display.all : display.none, editable = e1enableMA)
e1bbUpperBand = plot(e1smoothingMA + e1smoothingStDev, title = "EMA 1 Smoothing Upper Band", color=color.green, display = e1isBB ? display.all : display.none, editable = e1isBB)
e1bbLowerBand = plot(e1smoothingMA - e1smoothingStDev, title = "EMA 1 Smoothing Lower Band", color=color.green, display = e1isBB ? display.all : display.none, editable = e1isBB)
fill(e1bbUpperBand, e1bbLowerBand, color= e1isBB ? color.new(color.green, 90) : na, title="EMA 1 Smoothing Background", display = e1isBB ? display.all : display.none, editable = e1isBB)

// ══ EMA 2 — Moving Average Exponential ═══════════════════════════════
e2G = "EMA 2"
e2len = input.int(50, minval=1, title="Length", group = e2G)
e2src = input(close, title="Source", group = e2G)
e2offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.none, group = e2G)
e2out = ta.ema(e2src, e2len)
plot(e2out, title="EMA 2", color=color.blue, offset=e2offset)

// Smoothing MA inputs
e2GRP = "EMA 2 Smoothing"
e2maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = e2GRP, display = display.none)
var e2isBB = e2maTypeInput == "SMA + Bollinger Bands"
e2maLengthInput = input.int(14, "Length", group = e2GRP, display = display.none, active = e2maTypeInput != "None")
e2bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = e2GRP, display = display.none, active = e2isBB)
var e2enableMA = e2maTypeInput != "None"

// Smoothing MA plots
e2smoothingMA = e2enableMA ? ma(e2out, e2maLengthInput, e2maTypeInput) : na
e2smoothingStDev = e2isBB ? ta.stdev(e2out, e2maLengthInput) * e2bbMultInput : na
plot(e2smoothingMA, "EMA 2 Smoothing MA", color=color.yellow, display = e2enableMA ? display.all : display.none, editable = e2enableMA)
e2bbUpperBand = plot(e2smoothingMA + e2smoothingStDev, title = "EMA 2 Smoothing Upper Band", color=color.green, display = e2isBB ? display.all : display.none, editable = e2isBB)
e2bbLowerBand = plot(e2smoothingMA - e2smoothingStDev, title = "EMA 2 Smoothing Lower Band", color=color.green, display = e2isBB ? display.all : display.none, editable = e2isBB)
fill(e2bbUpperBand, e2bbLowerBand, color= e2isBB ? color.new(color.green, 90) : na, title="EMA 2 Smoothing Background", display = e2isBB ? display.all : display.none, editable = e2isBB)

// ══ SMA — Moving Average Simple ═══════════════════════════════════
s3G = "SMA"
s3len = input.int(150, minval=1, title="Length", group = s3G)
s3src = input(close, title="Source", group = s3G)
s3offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.none, group = s3G)
s3out = ta.sma(s3src, s3len)
plot(s3out, color=color.blue, title="SMA", offset=s3offset)

// Smoothing MA inputs
s3GRP = "SMA Smoothing"
s3maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = s3GRP, display = display.none)
var s3isBB = s3maTypeInput == "SMA + Bollinger Bands"
s3maLengthInput = input.int(14, "Length", group = s3GRP, display = display.none, active = s3maTypeInput != "None")
s3bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = s3GRP, display = display.none, active = s3isBB)
var s3enableMA = s3maTypeInput != "None"

// Smoothing MA plots
s3smoothingMA = s3enableMA ? ma(s3out, s3maLengthInput, s3maTypeInput) : na
s3smoothingStDev = s3isBB ? ta.stdev(s3out, s3maLengthInput) * s3bbMultInput : na
plot(s3smoothingMA, "SMA Smoothing MA", color=color.yellow, display = s3enableMA ? display.all : display.none, editable = s3enableMA)
s3bbUpperBand = plot(s3smoothingMA + s3smoothingStDev, title = "SMA Smoothing Upper Band", color=color.green, display = s3isBB ? display.all : display.none, editable = s3isBB)
s3bbLowerBand = plot(s3smoothingMA - s3smoothingStDev, title = "SMA Smoothing Lower Band", color=color.green, display = s3isBB ? display.all : display.none, editable = s3isBB)
fill(s3bbUpperBand, s3bbLowerBand, color= s3isBB ? color.new(color.green, 90) : na, title="SMA Smoothing Background", display = s3isBB ? display.all : display.none, editable = s3isBB)

// ══ בולינגר קצר — Bollinger Bands ═════════════════════════════════════
TT_LENGTH  = "The time period to be used in calculating the MA which creates the base for the Upper and Lower Bands."
TT_MA_TYPE = "Determines the type of Moving Average that is applied to the basis plot line."
TT_SOURCE  = "Determines what data from each bar will be used in calculations."
TT_MULT    = "The number of Standard Deviations away from the MA that the Upper and Lower Bands should be."
TT_OFFSET  = "Changing this number will move the Bollinger Bands either Forwards or Backwards relative to the current market."

b4G = "בולינגר קצר"
b4length = input.int(20,       "Length", minval = 1, tooltip =  TT_LENGTH, group = b4G)
b4maType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], tooltip = TT_MA_TYPE, group = b4G)
b4src =    input(close,        "Source", tooltip = TT_SOURCE, group = b4G)
b4mult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50,  tooltip = TT_MULT, group = b4G)
b4offset = input.int(0,        "Offset", minval = -500,  maxval = 500, tooltip =  TT_OFFSET, display = display.none, group = b4G)

bbMa(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

b4basis = bbMa(b4src, b4length, b4maType)
b4dev = b4mult * ta.stdev(b4src, b4length)
b4upper = b4basis + b4dev
b4lower = b4basis - b4dev

plot(b4basis, "בולינגר קצר Basis", color=#2962FF, offset = b4offset)
b4p1 = plot(b4upper, "בולינגר קצר Upper", color=#F23645, offset = b4offset)
b4p2 = plot(b4lower, "בולינגר קצר Lower", color=#089981, offset = b4offset)
fill(b4p1, b4p2, title = "בולינגר קצר Background", color=color.rgb(33, 150, 243, 95))

// ══ בולינגר ארוך — Bollinger Bands עם Timeframe (ברירת מחדל: שבועי) ═══
b5G = "בולינגר ארוך"
b5tf =     input.timeframe("W", "Timeframe", group = b5G)
b5length = input.int(20,       "Length", minval = 1, tooltip =  TT_LENGTH, group = b5G)
b5maType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], tooltip = TT_MA_TYPE, group = b5G)
b5src =    input(close,        "Source", tooltip = TT_SOURCE, group = b5G)
b5mult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50,  tooltip = TT_MULT, group = b5G)
b5offset = input.int(0,        "Offset", minval = -500,  maxval = 500, tooltip =  TT_OFFSET, display = display.none, group = b5G)

[b5basis, b5dev] = request.security(syminfo.tickerid, b5tf, [bbMa(b5src, b5length, b5maType), b5mult * ta.stdev(b5src, b5length)])
b5upper = b5basis + b5dev
b5lower = b5basis - b5dev

plot(b5basis, "בולינגר ארוך Basis", color=#2962FF, offset = b5offset)
b5p1 = plot(b5upper, "בולינגר ארוך Upper", color=#F23645, offset = b5offset)
b5p2 = plot(b5lower, "בולינגר ארוך Lower", color=#089981, offset = b5offset)
fill(b5p1, b5p2, title = "בולינגר ארוך Background", color=color.rgb(33, 150, 243, 95))

// ══ ⚠ שדות משותפים עם Checkup תחתון (לטבלה — מחושבים כאן, לא מצוירים) ══
// הקוד מועתק מהמובנים: Directional Movement Index, Average True Range, Commodity Channel Index
SHARED = "קיים גם ב-Checkup תחתון. אם משנים כאן — לשנות גם שם לאותו ערך."

// Directional Movement Index
dmiG = "DMI ⚠"
lensig = input.int(14, title="ADX Smoothing ⚠", minval=1, group = dmiG, tooltip = SHARED)
dmiLen = input.int(14, minval=1, title="DI Length ⚠", group = dmiG, tooltip = SHARED)
dmiUp = ta.change(high)
dmiDown = -ta.change(low)
plusDM = na(dmiUp) ? na : (dmiUp > dmiDown and dmiUp > 0 ? dmiUp : 0)
minusDM = na(dmiDown) ? na : (dmiDown > dmiUp and dmiDown > 0 ? dmiDown : 0)
trur = ta.rma(ta.tr, dmiLen)
plus = fixnan(100 * ta.rma(plusDM, dmiLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, dmiLen) / trur)
dmiSum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (dmiSum == 0 ? 1 : dmiSum), lensig)

// Average True Range
atrG = "ATR ⚠"
atrLength = input.int(title="Length ⚠", defval=14, minval=1, group = atrG, tooltip = SHARED)
atrSmoothing = input.string(title="Smoothing ⚠", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"], group = atrG, tooltip = SHARED)
ma_function(source, length) =>
	switch atrSmoothing
		"RMA" => ta.rma(source, length)
		"SMA" => ta.sma(source, length)
		"EMA" => ta.ema(source, length)
		=> ta.wma(source, length)
atr = ma_function(ta.tr(true), atrLength)

// Commodity Channel Index
cciG = "CCI ⚠"
cciLength = input.int(20, minval=1, title="Length ⚠", group = cciG, tooltip = SHARED)
cciSrc = input(hlc3, title="Source ⚠", group = cciG, tooltip = SHARED)
cciMa = ta.sma(cciSrc, cciLength)
cci = (cciSrc - cciMa) / (0.015 * ta.dev(cciSrc, cciLength))

// Volume — ממוצע ווליום ו-RVOL (לא חלק מהאינדיקטור המובנה Volume; נדרש לסקיל)
volG = "Volume ⚠"
volMaLen = input.int(10, minval=1, title="MA Length ⚠", group = volG, tooltip = SHARED)
volMa = ta.sma(volume, volMaLen)
rvol = volume / ta.sma(volume, volMaLen)[1]

// הסבר בתחתית חלון ההגדרות
NOTE = "השדות המסומנים ⚠ קיימים גם ב-Checkup תחתון. כשמשנים אחד מהם כאן — לשנות גם שם לאותו ערך."
sharedNote = input.string(NOTE, "⚠ הסבר", options = [NOTE], group = "⚠ הסבר")
