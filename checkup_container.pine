// ══ Moving Average Simple (150) — העתק של המובנה ══════════════════════
g3 = "Moving Average Simple 150"
s3len = input.int(150, minval=1, title="Length", group=g3)
s3src = input(close, title="Source", group=g3)
s3offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.data_window, group=g3)
s3out = ta.sma(s3src, s3len)
plot(s3out, color=color.blue, title="MA", offset=s3offset)
// Smoothing MA inputs
s3GRP = g3 + " — Smoothing"
s3maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = s3GRP, display = display.data_window)
s3maLengthInput = input.int(14, "Length", group = s3GRP, display = display.data_window)
s3bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = s3GRP, display = display.data_window)
s3isBB = s3maTypeInput == "SMA + Bollinger Bands"
s3enableMA = s3maTypeInput != "None"
s3smoothingMA = s3enableMA ? ma(s3out, s3maLengthInput, s3maTypeInput) : na
s3smoothingStDev = s3isBB ? ta.stdev(s3out, s3maLengthInput) * s3bbMultInput : na
plot(s3smoothingMA, "SMA-based MA", color=color.yellow, display = s3enableMA ? display.all : display.none)
s3bbUpperBand = plot(s3smoothingMA + s3smoothingStDev, title = "Upper Bollinger Band", color=color.green, display = s3isBB ? display.all : display.none)
s3bbLowerBand = plot(s3smoothingMA - s3smoothingStDev, title = "Lower Bollinger Band", color=color.green, display = s3isBB ? display.all : display.none)
fill(s3bbUpperBand, s3bbLowerBand, color= s3isBB ? color.new(color.green, 90) : na, title="Bollinger Bands Background Fill", display = s3isBB ? display.all : display.none)

// ══ Bollinger Bands (יומי) — העתק של המובנה ═══════════════════════════
g4 = "Bollinger Bands"
b4length = input.int(20, minval=1, title="Length", group=g4)
b4maType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=g4)
b4src = input(close, title="Source", group=g4)
b4mult = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group=g4)
b4basis = ma(b4src, b4length, b4maType)
b4dev = b4mult * ta.stdev(b4src, b4length)
b4upper = b4basis + b4dev
b4lower = b4basis - b4dev
b4offset = input.int(0, "Offset", minval = -500, maxval = 500, display = display.data_window, group=g4)
plot(b4basis, "Basis", color=#2962FF, offset = b4offset)
b4p1 = plot(b4upper, "Upper", color=#F23645, offset = b4offset)
b4p2 = plot(b4lower, "Lower", color=#089981, offset = b4offset)
fill(b4p1, b4p2, title = "Background", color=color.rgb(33, 150, 243, 95))

// ══ Bollinger Bands (שבועי) — העתק של המובנה, עם Timeframe ════════════
g5 = "Bollinger Bands (Timeframe)"
b5tf = input.timeframe("W", "Timeframe", group=g5)
b5length = input.int(20, minval=1, title="Length", group=g5)
b5maType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=g5)
b5src = input(close, title="Source", group=g5)
b5mult = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group=g5)
[b5basis, b5dev] = request.security(syminfo.tickerid, b5tf, [ma(b5src, b5length, b5maType), b5mult * ta.stdev(b5src, b5length)])
b5upper = b5basis + b5dev
b5lower = b5basis - b5dev
b5offset = input.int(0, "Offset", minval = -500, maxval = 500, display = display.data_window, group=g5)
plot(b5basis, "Basis", color=#2962FF, offset = b5offset)
b5p1 = plot(b5upper, "Upper", color=#F23645, offset = b5offset)
b5p2 = plot(b5lower, "Lower", color=#089981, offset = b5offset)
fill(b5p1, b5p2, title = "Background", color=color.rgb(33, 150, 243, 95))
