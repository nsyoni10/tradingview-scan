//@version=5
indicator(title="Checkup", shorttitle="Checkup", overlay=true)

// ══ Moving Average Exponential (20) — העתק של המובנה ══════════════════
g1 = "Moving Average Exponential 20"
e1len = input.int(20, minval=1, title="Length", group=g1)
e1src = input(close, title="Source", group=g1)
e1offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.data_window, group=g1)
e1out = ta.ema(e1src, e1len)
plot(e1out, title="EMA", color=color.blue, offset=e1offset)
// Smoothing MA inputs
e1GRP = g1 + " — Smoothing"
TT_BB = "Only applies when 'SMA + Bollinger Bands' is selected. Determines the distance between the SMA and the bands."
e1maTypeInput = input.string("None", "Type", options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = e1GRP, display = display.data_window)
e1maLengthInput = input.int(14, "Length", group = e1GRP, display = display.data_window)
e1bbMultInput = input.float(2.0, "BB StdDev", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = e1GRP, display = display.data_window)

// Smoothing MA Calculation
ma(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)

e1isBB = e1maTypeInput == "SMA + Bollinger Bands"
e1enableMA = e1maTypeInput != "None"
e1smoothingMA = e1enableMA ? ma(e1out, e1maLengthInput, e1maTypeInput) : na
e1smoothingStDev = e1isBB ? ta.stdev(e1out, e1maLengthInput) * e1bbMultInput : na
plot(e1smoothingMA, "EMA-based MA", color=color.yellow, display = e1enableMA ? display.all : display.none)
e1bbUpperBand = plot(e1smoothingMA + e1smoothingStDev, title = "Upper Bollinger Band", color=color.green, display = e1isBB ? display.all : display.none)
e1bbLowerBand = plot(e1smoothingMA - e1smoothingStDev, title = "Lower Bollinger Band", color=color.green, display = e1isBB ? display.all : display.none)
fill(e1bbUpperBand, e1bbLowerBand, color= e1isBB ? color.new(color.green, 90) : na, title="Bollinger Bands Background Fill", display = e1isBB ? display.all : display.none)

