//@version=5
indicator(title="Checkup", shorttitle="Checkup", overlay=true)

// EMA 1 — כמו Moving Average Exponential המובנה
len1 = input.int(20, minval=1, title="Length", group="EMA 1")
src1 = input(close, title="Source", group="EMA 1")
off1 = input.int(0, title="Offset", minval=-500, maxval=500, group="EMA 1")
col1 = input.color(color.blue, "Color", group="EMA 1")
plot(ta.ema(src1, len1), title="EMA 1", color=col1, offset=off1)

// EMA 2
len2 = input.int(50, minval=1, title="Length", group="EMA 2")
src2 = input(close, title="Source", group="EMA 2")
off2 = input.int(0, title="Offset", minval=-500, maxval=500, group="EMA 2")
col2 = input.color(color.orange, "Color", group="EMA 2")
plot(ta.ema(src2, len2), title="EMA 2", color=col2, offset=off2)

// SMA 150 — כמו Moving Average Simple המובנה
len3 = input.int(150, minval=1, title="Length", group="SMA 150")
src3 = input(close, title="Source", group="SMA 150")
off3 = input.int(0, title="Offset", minval=-500, maxval=500, group="SMA 150")
col3 = input.color(color.purple, "Color", group="SMA 150")
plot(ta.sma(src3, len3), title="SMA 150", color=col3, offset=off3)

// ── Bollinger Bands — העתק של האינדיקטור המובנה ─────────────────────
ma(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

// בולינגר קצר
bbsLength = input.int(20, minval=1, title="Length", group="בולינגר קצר")
bbsMaType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="בולינגר קצר")
bbsSrc    = input(close, title="Source", group="בולינגר קצר")
bbsMult   = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group="בולינגר קצר")
bbsOffset = input.int(0, "Offset", minval = -500, maxval = 500, group="בולינגר קצר")
bbsBasis  = ma(bbsSrc, bbsLength, bbsMaType)
bbsDev    = bbsMult * ta.stdev(bbsSrc, bbsLength)
bbsColBasis = input.color(#FF6D00, "Basis Color", group="בולינגר קצר")
bbsColBand  = input.color(#2962FF, "Bands Color", group="בולינגר קצר")
plot(bbsBasis, "בולינגר קצר Basis", color=bbsColBasis, offset = bbsOffset)
bbsP1 = plot(bbsBasis + bbsDev, "בולינגר קצר Upper", color=bbsColBand, offset = bbsOffset)
bbsP2 = plot(bbsBasis - bbsDev, "בולינגר קצר Lower", color=bbsColBand, offset = bbsOffset)
fill(bbsP1, bbsP2, title = "בולינגר קצר Background", color=color.new(bbsColBand, 95))

// בולינגר ארוך
bblLength = input.int(20, minval=1, title="Length", group="בולינגר ארוך")
bblMaType = input.string("SMA", "Basis MA Type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="בולינגר ארוך")
bblSrc    = input(close, title="Source", group="בולינגר ארוך")
bblMult   = input.float(2.0, minval=0.001, maxval=50, title="StdDev", group="בולינגר ארוך")
bblOffset = input.int(0, "Offset", minval = -500, maxval = 500, group="בולינגר ארוך")
bblTf     = input.timeframe("W", "Timeframe", group="בולינגר ארוך")
[bblBasis, bblDev] = request.security(syminfo.tickerid, bblTf, [ma(bblSrc, bblLength, bblMaType), bblMult * ta.stdev(bblSrc, bblLength)])
bblColBasis = input.color(#F44336, "Basis Color", group="בולינגר ארוך")
bblColBand  = input.color(#F44336, "Bands Color", group="בולינגר ארוך")
plot(bblBasis, "בולינגר ארוך Basis", color=bblColBasis, offset = bblOffset)
bblP1 = plot(bblBasis + bblDev, "בולינגר ארוך Upper", color=bblColBand, linewidth=2, offset = bblOffset)
bblP2 = plot(bblBasis - bblDev, "בולינגר ארוך Lower", color=bblColBand, linewidth=2, offset = bblOffset)
fill(bblP1, bblP2, title = "בולינגר ארוך Background", color=color.new(bblColBand, 97))

// ── סטטוס: ספים (רק באינדיקטור הזה) ─────────────────────────────────
showTable = input.bool(true, "להציג את הטבלה", group="סטטוס")
minAvgVol = input.int(500000, "ווליום ממוצע מינימלי", minval=0, group="סטטוס")
rvolMin   = input.float(1.2, "RVOL מינימלי", minval=0, step=0.1, group="סטטוס")
adxMin    = input.float(20, "ADX מינימלי", minval=0, group="סטטוס")

// ── ⚠ ההגדרות מכאן ועד הסוף קיימות גם ב-Checkup תחתון — לשנות בשניהם ──
SHARED = "קיים גם ב-Checkup תחתון. אם משנים כאן — לשנות גם שם לאותו ערך."

// Directional Movement Index — העתק של האינדיקטור המובנה (לא מצויר כאן, רק לטבלה)
lensig = input.int(14, title="ADX Smoothing ⚠", minval=1, maxval=50, group="DMI ⚠", tooltip=SHARED)
dmiLen = input.int(14, minval=1, title="DI Length ⚠", group="DMI ⚠", tooltip=SHARED)
dmiUp = ta.change(high)
dmiDown = -ta.change(low)
plusDM = na(dmiUp) ? na : (dmiUp > dmiDown and dmiUp > 0 ? dmiUp : 0)
minusDM = na(dmiDown) ? na : (dmiDown > dmiUp and dmiDown > 0 ? dmiDown : 0)
trur = ta.rma(ta.tr, dmiLen)
plus = fixnan(100 * ta.rma(plusDM, dmiLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, dmiLen) / trur)
dmiSum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (dmiSum == 0 ? 1 : dmiSum), lensig)

// Average True Range — העתק של האינדיקטור המובנה
atrLength = input.int(title="Length ⚠", defval=14, minval=1, group="ATR ⚠", tooltip=SHARED)
atrSmoothing = input.string(title="Smoothing ⚠", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"], group="ATR ⚠", tooltip=SHARED)
atrMa(source, length) =>
    switch atrSmoothing
        "RMA" => ta.rma(source, length)
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        => ta.wma(source, length)
atr = atrMa(ta.tr(true), atrLength)

// Commodity Channel Index — העתק של האינדיקטור המובנה
cciLength = input.int(20, minval=1, title="Length ⚠", group="CCI ⚠", tooltip=SHARED)
cciSrc = input(hlc3, title="Source ⚠", group="CCI ⚠", tooltip=SHARED)
cciMa = ta.sma(cciSrc, cciLength)
cci = (cciSrc - cciMa) / (0.015 * ta.dev(cciSrc, cciLength))

// Volume — ממוצע ו-RVOL (היום מול ממוצע הימים שלפניו)
volMaLen = input.int(10, minval=1, title="MA Length ⚠", group="Volume ⚠", tooltip=SHARED)
volMa = ta.sma(volume, volMaLen)
rvol = volume / ta.sma(volume, volMaLen)[1]

// הסבר בתחתית חלון ההגדרות
sharedNote = input.string("השדות המסומנים ⚠ קיימים גם ב-Checkup תחתון. כשמשנים אחד מהם כאן — לשנות גם שם לאותו ערך, אחרת הטבלה לא תתאים לחלון התחתון.", "⚠ הסבר", options=["השדות המסומנים ⚠ קיימים גם ב-Checkup תחתון. כשמשנים אחד מהם כאן — לשנות גם שם לאותו ערך, אחרת הטבלה לא תתאים לחלון התחתון."], group="⚠ הסבר")

// ── ערכים לסטטוס (מהקווים שעל הגרף) ──────────────────────────────────
sma150 = ta.sma(src3, len3)
// מיקום ברצועה ביחידות σ: 0 = על ה-Basis, +2 = על הרצועה העליונה
bbPos(c, basis, dev, mult) => dev > 0 ? (c - basis) / (dev / mult) : na
bd = bbPos(close, bbsBasis, bbsDev, bbsMult)
bw = bbPos(close, bblBasis, bblDev, bblMult)
dirUp = plus > minus
cciUp = cci > cci[1]

// ── סטטוס (כמו בסקיל) ────────────────────────────────────────────────
string status = ""
string why = ""
color stColor = color.gray
if volMa < minAvgVol
    status := "⛔ לא לסחור"
    why := "ווליום נמוך: " + str.tostring(volMa, "#,###") + " ביום"
else if atr / close < 0.005
    status := "⛔ לא לסחור"
    why := "מחיר קפוא"
else if not dirUp and adx >= adxMin
    status := "⛔ לא לסחור"
    why := "מגמת ירידה (-DI מעל +DI, ADX גבוה)"
else if not dirUp or (adx < adxMin and adx <= adx[1])
    status := "⛔ לא לסחור"
    why := "אין עדיין כיוון ללונג"
else if not na(bw) and bw > bblMult
    status := "🔴 מתוחה בשבועי"
    why := "מעל הרצועה העליונה של בולינגר ארוך"
    stColor := color.red
else if not na(bd) and bd > bbsMult
    status := "👁 מעקב"
    why := "מתוחה ביומי, טובה בשבועי — לבדוק שוב"
    stColor := color.orange
else if adx >= adxMin
    status := "✅ יש מקום"
    why := "טובה בשבועי וביומי, +DI מעל -DI, ADX גבוה"
    stColor := color.green
else
    status := "🔵 כמעט שם"
    why := "טובה בשבועי וביומי, ADX נמוך ועולה"
    stColor := color.blue

// ── טבלת הסטטוס: כל תנאי, הערך שלו ואם הוא מתקיים ────────────────────
var table t = table.new(position.top_right, 3, 11, border_width = 1)
okBg  = color.new(color.green, 75)
badBg = color.new(color.red, 75)
nBg   = color.new(color.gray, 85)
row(i, k, v, ok) =>
    table.cell(t, 0, i, k, text_color = color.white, bgcolor = color.navy, text_size = size.small)
    table.cell(t, 1, i, v, text_color = color.black, bgcolor = nBg, text_size = size.small)
    table.cell(t, 2, i, ok ? "✅" : "❌", text_color = color.black, bgcolor = ok ? okBg : badBg, text_size = size.small)

if barstate.islast
    table.clear(t, 0, 0, 2, 10)
    if showTable and timeframe.period != "D"
        table.cell(t, 0, 0, "Checkup", text_color = color.white, bgcolor = color.navy)
        table.cell(t, 1, 0, "הטבלה עובדת על גרף יומי (D)", text_color = color.black, bgcolor = color.yellow)
    else if showTable
        table.cell(t, 0, 0, "סטטוס", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 0, status, text_color = color.black, bgcolor = color.new(stColor, 60), text_size = size.small)
        table.cell(t, 2, 0, "", bgcolor = nBg)
        table.cell(t, 0, 1, "סיבה", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 1, why, text_color = color.black, bgcolor = nBg, text_size = size.small)
        table.cell(t, 2, 1, "", bgcolor = nBg)
        row(2,  "ווליום ממוצע ≥ " + str.tostring(minAvgVol, "#,###"), str.tostring(volMa, "#,###"), volMa >= minAvgVol)
        row(3,  "+DI מעל -DI", str.tostring(plus, "0.0") + " / " + str.tostring(minus, "0.0"), dirUp)
        row(4,  "ADX ≥ " + str.tostring(adxMin), str.tostring(adx, "0.0") + (adx > adx[1] ? " ↑" : " ↓"), adx >= adxMin)
        row(5,  "בולינגר ארוך ≤ +" + str.tostring(bblMult) + "σ", (na(bw) ? "—" : str.tostring(bw, "+0.00;-0.00")) + "σ", na(bw) or bw <= bblMult)
        row(6,  "בולינגר קצר ≤ +" + str.tostring(bbsMult) + "σ", (na(bd) ? "—" : str.tostring(bd, "+0.00;-0.00")) + "σ", na(bd) or bd <= bbsMult)
        row(7,  "מעל SMA 150", str.tostring(sma150, "0.00"), close > sma150)
        row(8,  "RVOL ≥ " + str.tostring(rvolMin), str.tostring(rvol, "0.00"), rvol >= rvolMin)
        row(9,  "CCI עולה", str.tostring(cci, "0") + " (אתמול " + str.tostring(cci[1], "0") + ")", cciUp)
        row(10, "ATR", str.tostring(atr, "0.00") + " (" + str.tostring(atr / close * 100, "0.0") + "%)", atr / close >= 0.005)
