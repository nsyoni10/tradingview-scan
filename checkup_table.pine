//@version=6
indicator(title="Checkup Table", shorttitle="Checkup Table", overlay=true)
// אינדיקטור נפרד — רק טבלת סטטוס, כמו בסקיל checkup. לא מצייר קווים ולא תלוי ב-Checkup.
// כל ערך מחושב כאן עם קוד המקור של האינדיקטור המובנה של TradingView (גרסה 6).
// כדי שהטבלה תתאים למה שרואים על הגרף, ההגדרות כאן צריכות להיות זהות להגדרות ב-Checkup ובאינדיקטורים המובנים.

TT_CHECKUP = "צריך להיות זהה להגדרה ב-Checkup."
TT_DMI     = "צריך להיות זהה להגדרה ב-Directional Movement Index שעל הגרף."
TT_ATR     = "צריך להיות זהה להגדרה ב-Average True Range שעל הגרף."
TT_CCI     = "צריך להיות זהה להגדרה ב-Commodity Channel Index שעל הגרף."

// ══ טבלה ══════════════════════════════════════════════════════════════
tG = "טבלה"
showTable = input.bool(true, "להציג את הטבלה", group = tG)
minAvgVol = input.int(500000, "ווליום ממוצע מינימלי", minval = 0, group = tG)
volMaLen  = input.int(10, "ווליום ממוצע — מספר ימים", minval = 1, group = tG)
rvolMin   = input.float(1.2, "RVOL מינימלי", minval = 0, step = 0.1, group = tG)
adxMin    = input.float(20, "ADX מינימלי", minval = 0, group = tG)

// ══ SMA — Moving Average Simple ═══════════════════════════════════════
sG = "SMA"
sLen = input.int(150, minval=1, title="Length", group = sG, tooltip = TT_CHECKUP)
sSrc = input(close, title="Source", group = sG, tooltip = TT_CHECKUP)
sOut = ta.sma(sSrc, sLen)

// ══ בולינגר קצר — Bollinger Bands ═════════════════════════════════════
bbMa(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

bsG = "בולינגר קצר"
bsLength = input.int(20,       "Length", minval = 1, group = bsG, tooltip = TT_CHECKUP)
bsMaType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = bsG, tooltip = TT_CHECKUP)
bsSrc =    input(close,        "Source", group = bsG, tooltip = TT_CHECKUP)
bsMult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50, group = bsG, tooltip = TT_CHECKUP)
bsBasis = bbMa(bsSrc, bsLength, bsMaType)
bsDev = bsMult * ta.stdev(bsSrc, bsLength)

// ══ בולינגר ארוך — Bollinger Bands עם Timeframe ═══════════════════════
blG = "בולינגר ארוך"
blTf =     input.timeframe("W", "Timeframe", group = blG, tooltip = TT_CHECKUP)
blLength = input.int(20,       "Length", minval = 1, group = blG, tooltip = TT_CHECKUP)
blMaType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = blG, tooltip = TT_CHECKUP)
blSrc =    input(close,        "Source", group = blG, tooltip = TT_CHECKUP)
blMult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50, group = blG, tooltip = TT_CHECKUP)
[blBasis, blDev] = request.security(syminfo.tickerid, blTf, [bbMa(blSrc, blLength, blMaType), blMult * ta.stdev(blSrc, blLength)])

// ══ DMI — Directional Movement Index ══════════════════════════════════
dG = "DMI"
lensig = input.int(14, title="ADX Smoothing", minval=1, group = dG, tooltip = TT_DMI)
dmiLen = input.int(14, minval=1, title="DI Length", group = dG, tooltip = TT_DMI)
dmiUp = ta.change(high)
dmiDown = -ta.change(low)
plusDM = na(dmiUp) ? na : (dmiUp > dmiDown and dmiUp > 0 ? dmiUp : 0)
minusDM = na(dmiDown) ? na : (dmiDown > dmiUp and dmiDown > 0 ? dmiDown : 0)
trur = ta.rma(ta.tr, dmiLen)
plus = fixnan(100 * ta.rma(plusDM, dmiLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, dmiLen) / trur)
dmiSum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (dmiSum == 0 ? 1 : dmiSum), lensig)

// ══ ATR — Average True Range ══════════════════════════════════════════
aG = "ATR"
atrLength = input.int(title="Length", defval=14, minval=1, group = aG, tooltip = TT_ATR)
atrSmoothing = input.string(title="Smoothing", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"], group = aG, tooltip = TT_ATR)
ma_function(source, length) =>
	switch atrSmoothing
		"RMA" => ta.rma(source, length)
		"SMA" => ta.sma(source, length)
		"EMA" => ta.ema(source, length)
		=> ta.wma(source, length)
atr = ma_function(ta.tr(true), atrLength)

// ══ CCI — Commodity Channel Index ═════════════════════════════════════
cG = "CCI"
cciLength = input.int(20, minval=1, title="Length", group = cG, tooltip = TT_CCI)
cciSrc = input(hlc3, title="Source", group = cG, tooltip = TT_CCI)
cciMa = ta.sma(cciSrc, cciLength)
cci = (cciSrc - cciMa) / (0.015 * ta.dev(cciSrc, cciLength))

// ══ ווליום ממוצע ו-RVOL (יום אחרון מול ממוצע הימים שלפניו) ══════════════
volMa = ta.sma(volume, volMaLen)
rvol = volume / ta.sma(volume, volMaLen)[1]

// ══ סטטוס — אותה לוגיקה כמו בסקיל checkup ════════════════════════════
// מיקום הסגירה ברצועה ביחידות σ: 0 = על ה-Basis, +2 = על הרצועה העליונה
bbPos(c, basis, dev, mult) => dev > 0 ? (c - basis) / (dev / mult) : na
bd = bbPos(close, bsBasis, bsDev, bsMult)
bw = bbPos(close, blBasis, blDev, blMult)
dirUp = plus > minus
adxUp = adx > adx[1]
cciUp = cci > cci[1]
cciPrev = cci[1]

string status = ""
string why = ""
color stColor = color.gray
if volMa < minAvgVol
    status := "⛔ לא לסחור"
    why := "ווליום ממוצע נמוך"
else if atr / close < 0.005
    status := "⛔ לא לסחור"
    why := "מחיר קפוא"
else if not dirUp and adx >= adxMin
    status := "⛔ לא לסחור"
    why := "מגמת ירידה: -DI מעל +DI, ADX גבוה"
else if not dirUp or (adx < adxMin and not adxUp)
    status := "⛔ לא לסחור"
    why := "אין עדיין כיוון ללונג"
else if not na(bw) and bw > blMult
    status := "🔴 מתוחה בשבועי"
    why := "מעל הרצועה העליונה של בולינגר ארוך"
    stColor := color.red
else if not na(bd) and bd > bsMult
    status := "👁 מעקב"
    why := "מתוחה ביומי, טובה בשבועי — לבדוק שוב"
    stColor := color.orange
else if adx >= adxMin
    status := "✅ יש מקום"
    why := "טובה בשבועי וביומי, +DI מעל -DI, ADX גבוה"
    stColor := color.green
else
    status := "🔵 כמעט שם"
    why := "טובה בשבועי וביומי, ADX נמוך ועולה"
    stColor := color.blue

// ══ הטבלה ═════════════════════════════════════════════════════════════
var table t = table.new(position.top_right, 3, 11, border_width = 1)
okBg  = color.new(color.green, 75)
badBg = color.new(color.red, 75)
nBg   = color.new(color.gray, 85)
row(i, k, v, ok) =>
    table.cell(t, 0, i, k, text_color = color.white, bgcolor = color.navy, text_size = size.small)
    table.cell(t, 1, i, v, text_color = color.black, bgcolor = nBg, text_size = size.small)
    table.cell(t, 2, i, ok ? "✅" : "❌", text_color = color.black, bgcolor = ok ? okBg : badBg, text_size = size.small)

if barstate.islast
    table.clear(t, 0, 0, 2, 10)
    if showTable and timeframe.period != "D"
        table.cell(t, 0, 0, "Checkup Table", text_color = color.white, bgcolor = color.navy)
        table.cell(t, 1, 0, "הטבלה עובדת על גרף יומי (D)", text_color = color.black, bgcolor = color.yellow)
    else if showTable
        table.cell(t, 0, 0, "סטטוס", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 0, status, text_color = color.black, bgcolor = color.new(stColor, 60), text_size = size.small)
        table.cell(t, 2, 0, "", bgcolor = nBg)
        table.cell(t, 0, 1, "סיבה", text_color = color.white, bgcolor = color.navy, text_size = size.small)
        table.cell(t, 1, 1, why, text_color = color.black, bgcolor = nBg, text_size = size.small)
        table.cell(t, 2, 1, "", bgcolor = nBg)
        row(2,  "ווליום ממוצע " + str.tostring(volMaLen) + " ימים ≥ " + str.tostring(minAvgVol, "#,###"), str.tostring(volMa, "#,###"), volMa >= minAvgVol)
        row(3,  "DMI: +DI מעל -DI", str.tostring(plus, "0.0") + " / " + str.tostring(minus, "0.0"), dirUp)
        row(4,  "DMI: ADX ≥ " + str.tostring(adxMin), str.tostring(adx, "0.0") + (adxUp ? " ↑" : " ↓"), adx >= adxMin)
        row(5,  "בולינגר ארוך ≤ +" + str.tostring(blMult) + "σ", (na(bw) ? "—" : str.tostring(bw, "+0.00;-0.00")) + "σ", na(bw) or bw <= blMult)
        row(6,  "בולינגר קצר ≤ +" + str.tostring(bsMult) + "σ", (na(bd) ? "—" : str.tostring(bd, "+0.00;-0.00")) + "σ", na(bd) or bd <= bsMult)
        row(7,  "מעל SMA " + str.tostring(sLen), str.tostring(sOut, "0.00"), close > sOut)
        row(8,  "RVOL ≥ " + str.tostring(rvolMin), str.tostring(rvol, "0.00"), rvol >= rvolMin)
        row(9,  "CCI עולה", str.tostring(cci, "0") + " (אתמול " + str.tostring(cciPrev, "0") + ")", cciUp)
        row(10, "ATR", str.tostring(atr, "0.00") + " (" + str.tostring(atr / close * 100, "0.0") + "%)", atr / close >= 0.005)
