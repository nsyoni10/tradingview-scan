//@version=6
indicator(title="Checkup Table", shorttitle="Checkup Table", overlay=true)
// אינדיקטור נפרד — רק טבלת סטטוס, כמו בסקיל checkup. לא מצייר קווים ולא תלוי ב-Checkup.
// כל ערך מחושב כאן עם קוד המקור של האינדיקטור המובנה של TradingView (גרסה 6).
// כדי שהטבלה תתאים למה שרואים על הגרף, ההגדרות כאן צריכות להיות זהות להגדרות ב-Checkup ובאינדיקטורים המובנים.

TT_CHECKUP = "צריך להיות זהה להגדרה ב-Checkup."
TT_DMI     = "צריך להיות זהה להגדרה ב-Directional Movement Index שעל הגרף."
TT_ATR     = "צריך להיות זהה להגדרה ב-Average True Range שעל הגרף."
TT_CCI     = "צריך להיות זהה להגדרה ב-Commodity Channel Index שעל הגרף."

// ══ טבלה ══════════════════════════════════════════════════════════════
tG = "טבלה"
showTable = input.bool(true, "להציג את הטבלה", group = tG)
sizeInput = input.string("normal", "גודל הטקסט", options = ["tiny", "small", "normal", "large", "huge"], group = tG)
tSize = switch sizeInput
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.huge
minAvgVol = input.int(500000, "ווליום ממוצע מינימלי", minval = 0, group = tG)
volMaLen  = input.int(10, "ווליום ממוצע — מספר ימים", minval = 1, group = tG)
rvolMin   = input.float(1.2, "RVOL מינימלי", minval = 0, step = 0.1, group = tG)
adxMin    = input.float(20, "ADX מינימלי", minval = 0, group = tG)

// ══ SMA — Moving Average Simple ═══════════════════════════════════════
sG = "SMA"
sLen = input.int(150, minval=1, title="Length", group = sG, tooltip = TT_CHECKUP)
sSrc = input(close, title="Source", group = sG, tooltip = TT_CHECKUP)
sOut = ta.sma(sSrc, sLen)

// ══ בולינגר קצר — Bollinger Bands ═════════════════════════════════════
bbMa(source, length, _type) =>
    switch _type
        "SMA" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

bsG = "בולינגר קצר"
bsLength = input.int(20,       "Length", minval = 1, group = bsG, tooltip = TT_CHECKUP)
bsMaType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = bsG, tooltip = TT_CHECKUP)
bsSrc =    input(close,        "Source", group = bsG, tooltip = TT_CHECKUP)
bsMult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50, group = bsG, tooltip = TT_CHECKUP)
bsBasis = bbMa(bsSrc, bsLength, bsMaType)
bsDev = bsMult * ta.stdev(bsSrc, bsLength)

// ══ בולינגר ארוך — Bollinger Bands עם Timeframe ═══════════════════════
blG = "בולינגר ארוך"
blTf =     input.timeframe("W", "Timeframe", group = blG, tooltip = TT_CHECKUP)
blLength = input.int(20,       "Length", minval = 1, group = blG, tooltip = TT_CHECKUP)
blMaType = input.string("SMA", "Basis MA Type",      options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = blG, tooltip = TT_CHECKUP)
blSrc =    input(close,        "Source", group = blG, tooltip = TT_CHECKUP)
blMult =   input.float(2.0,    "StdDev", minval = 0.001, maxval = 50, group = blG, tooltip = TT_CHECKUP)
[blBasis, blDev] = request.security(syminfo.tickerid, blTf, [bbMa(blSrc, blLength, blMaType), blMult * ta.stdev(blSrc, blLength)])

// ══ DMI — Directional Movement Index ══════════════════════════════════
dG = "DMI"
lensig = input.int(14, title="ADX Smoothing", minval=1, group = dG, tooltip = TT_DMI)
dmiLen = input.int(14, minval=1, title="DI Length", group = dG, tooltip = TT_DMI)
dmiUp = ta.change(high)
dmiDown = -ta.change(low)
plusDM = na(dmiUp) ? na : (dmiUp > dmiDown and dmiUp > 0 ? dmiUp : 0)
minusDM = na(dmiDown) ? na : (dmiDown > dmiUp and dmiDown > 0 ? dmiDown : 0)
trur = ta.rma(ta.tr, dmiLen)
plus = fixnan(100 * ta.rma(plusDM, dmiLen) / trur)
minus = fixnan(100 * ta.rma(minusDM, dmiLen) / trur)
dmiSum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (dmiSum == 0 ? 1 : dmiSum), lensig)

// ══ ATR — Average True Range ══════════════════════════════════════════
aG = "ATR"
atrLength = input.int(title="Length", defval=14, minval=1, group = aG, tooltip = TT_ATR)
atrSmoothing = input.string(title="Smoothing", defval="RMA", options=["RMA", "SMA", "EMA", "WMA"], group = aG, tooltip = TT_ATR)
ma_function(source, length) =>
	switch atrSmoothing
		"RMA" => ta.rma(source, length)
		"SMA" => ta.sma(source, length)
		"EMA" => ta.ema(source, length)
		=> ta.wma(source, length)
atr = ma_function(ta.tr(true), atrLength)

// ══ CCI — Commodity Channel Index ═════════════════════════════════════
cG = "CCI"
cciLength = input.int(20, minval=1, title="Length", group = cG, tooltip = TT_CCI)
cciSrc = input(hlc3, title="Source", group = cG, tooltip = TT_CCI)
cciMa = ta.sma(cciSrc, cciLength)
cci = (cciSrc - cciMa) / (0.015 * ta.dev(cciSrc, cciLength))

// ══ ווליום ממוצע ו-RVOL (יום אחרון מול ממוצע הימים שלפניו) ══════════════
volMa = ta.sma(volume, volMaLen)
rvol = volume / ta.sma(volume, volMaLen)[1]

// ══ סטטוס — אותה לוגיקה כמו בסקיל checkup ════════════════════════════
// מיקום הסגירה ברצועה ביחידות σ: 0 = על ה-Basis, +2 = על הרצועה העליונה
bbPos(c, basis, dev, mult) => dev > 0 ? (c - basis) / (dev / mult) : na
bd = bbPos(close, bsBasis, bsDev, bsMult)
bw = bbPos(close, blBasis, blDev, blMult)
dirUp = plus > minus
adxUp = adx > adx[1]
cciUp = cci > cci[1]
cciPrev = cci[1]

string status = ""
string why = ""
color stColor = color.gray
if volMa < minAvgVol
    status := "⛔ לא לסחור"
    why := "ווליום ממוצע נמוך"
else if atr / close < 0.005
    status := "⛔ לא לסחור"
    why := "מחיר קפוא"
else if not dirUp and adx >= adxMin
    status := "⛔ לא לסחור"
    why := "מגמת ירידה: -DI מעל +DI, ADX גבוה"
else if not dirUp or (adx < adxMin and not adxUp)
    status := "⛔ לא לסחור"
    why := "אין עדיין כיוון ללונג"
else if not na(bw) and bw > blMult
    status := "🔴 מתוחה בשבועי"
    why := "מעל הרצועה העליונה של בולינגר ארוך"
    stColor := color.red
else if not na(bd) and bd > bsMult
    status := "👁 מעקב"
    why := "מתוחה ביומי, טובה בשבועי — לבדוק שוב"
    stColor := color.orange
else if adx >= adxMin
    status := "✅ יש מקום"
    why := "טובה בשבועי וביומי, +DI מעל -DI, ADX גבוה"
    stColor := color.green
else
    status := "🔵 כמעט שם"
    why := "טובה בשבועי וביומי, ADX נמוך ועולה"
    stColor := color.blue

// ══ הטבלה — באותה צורה כמו הדוגמה "Price vs MA" במדריך הרשמי של Pine (Tables) ══
// var table + table.cell ישירות בתוך if barstate.islast, בלי פונקציית עזר ובלי table.clear
okBg  = color.new(color.green, 75)
badBg = color.new(color.red, 75)
nBg   = color.new(color.gray, 85)
hBg   = color.navy

var table panel = table.new(position.top_right, 3, 11, border_width = 1)
if barstate.islast and showTable and not timeframe.isdaily
    table.cell(panel, 0, 0, "Checkup Table", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 0, "הטבלה עובדת על גרף יומי (D)", text_color = color.black, bgcolor = color.yellow, text_size = tSize)
if barstate.islast and showTable and timeframe.isdaily
    // שורה 0 — סטטוס
    table.cell(panel, 0, 0, "סטטוס", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 0, status, text_color = color.black, bgcolor = color.new(stColor, 60), text_size = tSize)
    table.cell(panel, 2, 0, "", bgcolor = nBg, text_size = tSize)
    // שורה 1 — סיבה
    table.cell(panel, 0, 1, "סיבה", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 1, why, text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 1, "", bgcolor = nBg, text_size = tSize)
    // שורה 2 — ווליום ממוצע
    okVol = volMa >= minAvgVol
    table.cell(panel, 0, 2, "ווליום ממוצע " + str.tostring(volMaLen) + " ימים ≥ " + str.tostring(minAvgVol, "#,###"), text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 2, str.tostring(volMa, "#,###"), text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 2, okVol ? "✅" : "❌", text_color = color.black, bgcolor = okVol ? okBg : badBg, text_size = tSize)
    // שורה 3 — +DI מול -DI
    table.cell(panel, 0, 3, "DMI: +DI מעל -DI", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 3, str.tostring(plus, "0.0") + " / " + str.tostring(minus, "0.0"), text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 3, dirUp ? "✅" : "❌", text_color = color.black, bgcolor = dirUp ? okBg : badBg, text_size = tSize)
    // שורה 4 — ADX
    okAdx = adx >= adxMin
    table.cell(panel, 0, 4, "DMI: ADX ≥ " + str.tostring(adxMin), text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 4, str.tostring(adx, "0.0") + (adxUp ? " ↑" : " ↓"), text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 4, okAdx ? "✅" : "❌", text_color = color.black, bgcolor = okAdx ? okBg : badBg, text_size = tSize)
    // שורה 5 — בולינגר ארוך
    okBw = na(bw) or bw <= blMult
    table.cell(panel, 0, 5, "בולינגר ארוך ≤ +" + str.tostring(blMult) + "σ", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 5, (na(bw) ? "—" : str.tostring(bw, "+0.00;-0.00")) + "σ", text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 5, okBw ? "✅" : "❌", text_color = color.black, bgcolor = okBw ? okBg : badBg, text_size = tSize)
    // שורה 6 — בולינגר קצר
    okBd = na(bd) or bd <= bsMult
    table.cell(panel, 0, 6, "בולינגר קצר ≤ +" + str.tostring(bsMult) + "σ", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 6, (na(bd) ? "—" : str.tostring(bd, "+0.00;-0.00")) + "σ", text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 6, okBd ? "✅" : "❌", text_color = color.black, bgcolor = okBd ? okBg : badBg, text_size = tSize)
    // שורה 7 — מעל SMA
    okSma = close > sOut
    table.cell(panel, 0, 7, "מעל SMA " + str.tostring(sLen), text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 7, str.tostring(sOut, "0.00"), text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 7, okSma ? "✅" : "❌", text_color = color.black, bgcolor = okSma ? okBg : badBg, text_size = tSize)
    // שורה 8 — RVOL
    okRvol = rvol >= rvolMin
    table.cell(panel, 0, 8, "RVOL ≥ " + str.tostring(rvolMin), text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 8, str.tostring(rvol, "0.00"), text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 8, okRvol ? "✅" : "❌", text_color = color.black, bgcolor = okRvol ? okBg : badBg, text_size = tSize)
    // שורה 9 — CCI
    table.cell(panel, 0, 9, "CCI עולה", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 9, str.tostring(cci, "0") + " (אתמול " + str.tostring(cciPrev, "0") + ")", text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 9, cciUp ? "✅" : "❌", text_color = color.black, bgcolor = cciUp ? okBg : badBg, text_size = tSize)
    // שורה 10 — ATR
    okAtr = atr / close >= 0.005
    table.cell(panel, 0, 10, "ATR", text_color = color.white, bgcolor = hBg, text_size = tSize)
    table.cell(panel, 1, 10, str.tostring(atr, "0.00") + " (" + str.tostring(atr / close * 100, "0.0") + "%)", text_color = color.black, bgcolor = nBg, text_size = tSize)
    table.cell(panel, 2, 10, okAtr ? "✅" : "❌", text_color = color.black, bgcolor = okAtr ? okBg : badBg, text_size = tSize)
